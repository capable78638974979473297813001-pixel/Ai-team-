# Copy to .env.local (or run `npm run setup` to generate secrets).
APP_URL=http://localhost:3000
DATABASE_URL=postgres://aiteam:aiteam@localhost:5432/aiteam

# Comma-separated version:base64(32 bytes). First key encrypts; all keys decrypt.
ENCRYPTION_KEYS=v1:REPLACE_WITH_32_RANDOM_BYTES_BASE64
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS

# Only when behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Simulated agents for local development (always off in production).
ENABLE_SANDBOX_AGENTS=true

# Google OAuth for the Gemini API. Register redirect URI: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_QUOTA_PROJECT=
# GOOGLE_GEMINI_SCOPES="openid email https://www.googleapis.com/auth/generative-language.retriever"

# Sign in with ChatGPT (requires OpenAI approval for hosted apps). Redirect: ${APP_URL}/api/oauth/openai/callback
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_CLIENT_SECRET=
# OPENAI_SIWC_SCOPES="openid profile email offline_access resource.invoke chatgpt.tokens.use.direct"
# OPENAI_SIWC_HOST_ID=

# Optional pricing for cost limits: {"openai:gpt-6.1":{"inputPerMTok":2,"outputPerMTok":8}}
# PRICING_JSON=

# Cross-instance coordination (default: postgres in production, memory otherwise)
# EVENT_BUS=postgres
# RATE_LIMIT_STORE=postgres

# Observability
# METRICS_TOKEN=at-least-16-random-chars   # enables GET /api/metrics
# LOG_FORMAT=json                          # default in production; "text" to opt out
# LOG_ACCESS=true                          # access lines in text mode

# Limits and webhooks
# MAX_CONCURRENT_RUNS=3
# WEBHOOKS_ALLOW_PRIVATE=false   # dev only; ignored in production
